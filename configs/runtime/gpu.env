# Opt-in graphics deployment; no model-specific IDs or workstation paths.
# GPU devices and display integration must be supplied to real renderer services.
UAV_RENDER_MODE=gpu
UAV_HEADLESS=false
UAV_SLAM_RATE_HZ=10
UAV_CAMERA_PITCH_RAD=1.1
UAV_REAL_TIME_FACTOR=0.5
BACKEND_PORT=18080
OUTPUTS_PATH=./outputs
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
