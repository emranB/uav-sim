BACKEND_PORT=18080
UAV_RENDER_MODE=cpu
UAV_HEADLESS=false
OUTPUTS_PATH=./outputs
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
